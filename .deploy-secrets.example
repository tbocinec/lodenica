# Lodenica — Websupport deploy secrets (template).
# One file per client: copy to `.deploy-secrets.<slug>` (gitignored), fill
# in the real values and deploy with `scripts/deploy-rezervacie.sh --client
# <slug>`. The plain `.deploy-secrets` is the default when no --client is
# given. See docs/CLIENT-ONBOARDING.md.
#
# Source it before running deploys/SSH/psql against production:
#   set -a; source .deploy-secrets; set +a
#
# Two hosting profiles supported:
#   1. SSH-enabled Websupport — see DEPLOY_SSH_* + first DB block
#   2. SFTP-only Websupport   — see DEPLOY_SFTP_* + second DB block
# scripts/deploy-rezervacie.sh consumes profile #2.

#────────────────────────────────────────────────────────────────────────────
# Profile 1: SSH-enabled Websupport (e.g. tomas.gart.sk)
#────────────────────────────────────────────────────────────────────────────
DEPLOY_SSH_HOST='shell.r2.websupport.sk'
DEPLOY_SSH_PORT='<port>'
DEPLOY_SSH_USER='<uid…>'
DEPLOY_SSH_PASSWORD='<password>'

DEPLOY_LARAVEL_APP='<$HOME>/lodenica-app'
DEPLOY_WEB_DOCROOT='<$HOME>/<domain>/sub/<subdomain>'

#────────────────────────────────────────────────────────────────────────────
# Profile 2: SFTP-only Websupport (e.g. rezervacie.lodenicakvs.sk)
#
# Used by scripts/deploy-rezervacie.sh. Run with VPN OFF — port 22
# outbound through corporate VPNs is usually blocked.
#────────────────────────────────────────────────────────────────────────────
DEPLOY_SFTP_HOST='<sftp-host>'
DEPLOY_SFTP_PORT='22'
DEPLOY_SFTP_USER='<sftp-user>'
DEPLOY_SFTP_PASSWORD='<sftp-password>'

# Discover with:  scripts/deploy-rezervacie.sh --explore
DEPLOY_LARAVEL_APP_REMOTE='<remote-path>/lodenica-app'
DEPLOY_DOCROOT_REMOTE='<remote-path>/sub/<subdomain>'

# Persist this after the first deploy so re-deploys keep the same key.
# DEPLOY_APP_KEY='base64:...'

#────────────────────────────────────────────────────────────────────────────
# Managed Postgres (shared between profiles — pick whichever DB applies)
#────────────────────────────────────────────────────────────────────────────
PROD_DB_HOST='<db-host>'
PROD_DB_PORT='5432'
PROD_DB_NAME='<dbname>'
PROD_DB_USER='<dbuser>'
PROD_DB_PASSWORD='<dbpassword>'

# Public site
PROD_DOMAIN='<your.domain>'
PROD_BASE_URL='https://<your.domain>'

#────────────────────────────────────────────────────────────────────────────
# Site identity — install-time defaults. The admin can override every value
# later in the SPA (Administrácia → Systém → Nastavenia stránky); only
# SITE_NAME is required. Empty/absent = built-in default.
#────────────────────────────────────────────────────────────────────────────
SITE_NAME='Lodenica Klub'                    # REQUIRED — e-mails, ICS, browser title
SITE_SHORT_NAME='Rezervácie Klub'            # header + login heading (default: SITE_NAME)
SITE_CLUB_NAME='Vodácky klub …'              # full club name for content pages
SITE_CONTACT_EMAIL='rezervacie@example.sk'   # footer, FAQ, "waiting" banner
# MAIL_ADMIN_ADDRESS='spravca@example.sk'    # new-member notices (default: SITE_CONTACT_EMAIL)
SITE_ADDRESS='Ulica 1, 900 01 Mesto'         # ICS / Google Calendar location
# SITE_MAPS_URL='https://maps.app.goo.gl/…'
# SITE_WEBSITE_URL='https://www.example.sk'
# SITE_RULES_URL='https://…'                 # prevádzkový poriadok
# SITE_GDPR_NOTICE_URL='https://…'
# SITE_GDPR_CONSENT_URL='https://…'
# SITE_STATUTES_URL='https://…'
# SITE_OPERATOR_NOTICE='Prevádzkovateľ: …, IČO: ….'
# SITE_MEMBER_ID_EXAMPLE='001'
# SITE_THEME='ocean'                         # ocean | forest | sunset | berry | graphite
SITE_FEATURE_TRAFFIC_LIGHT='false'           # Danube paddling traffic light (Bratislava only)
SITE_FEATURE_EXPEDITIONS='true'
# SITE_LOGO_FILE='branding/<slug>/logo-192.png'  # png/jpg/webp ≤ 2 MB, uploaded at deploy

#────────────────────────────────────────────────────────────────────────────
# First install only — creates the first admin. Ignored once an admin
# exists. A production install without these and without an admin FAILS
# the seed step on purpose.
#────────────────────────────────────────────────────────────────────────────
ADMIN_EMAIL='admin@example.sk'
ADMIN_PASSWORD='change-me-now'
ADMIN_NAME='Správca'

#────────────────────────────────────────────────────────────────────────────
# Transactional e-mail (Websupport SMTP). MAIL_USERNAME and
# MAIL_FROM_ADDRESS are required whenever MAIL_PASSWORD is set; with an
# empty password the app logs e-mails instead of sending them.
#────────────────────────────────────────────────────────────────────────────
# MAIL_HOST='smtp.m1.websupport.sk'
# MAIL_PORT='465'
MAIL_USERNAME='potvrdenie@example.sk'
MAIL_FROM_ADDRESS='potvrdenie@example.sk'
MAIL_PASSWORD=''
# MAIL_FROM_NAME defaults to SITE_NAME
