APP_NAME=Lodenica
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=sk
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=sk_SK

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=lodenica
DB_USERNAME=lodenica
DB_PASSWORD=lodenica

# Comma-separated list of origins allowed to call /api/v1/*. For same-origin
# (frontend + backend on the same host) this is irrelevant but harmless.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

SESSION_DRIVER=array
QUEUE_CONNECTION=sync
CACHE_STORE=array

# Site identity — install-time defaults for App\Services\SiteConfig. The
# admin overrides any of them in Administrácia → Nastavenia stránky.
SITE_NAME="Lodenica (dev)"
# SITE_SHORT_NAME=
# SITE_CLUB_NAME=
# SITE_CONTACT_EMAIL=
# MAIL_ADMIN_ADDRESS=
# SITE_ADDRESS= SITE_MAPS_URL= SITE_WEBSITE_URL= SITE_RULES_URL=
# SITE_GDPR_NOTICE_URL= SITE_GDPR_CONSENT_URL= SITE_STATUTES_URL=
# SITE_OPERATOR_NOTICE= SITE_MEMBER_ID_EXAMPLE= SITE_THEME=ocean
SITE_FEATURE_TRAFFIC_LIGHT=true
SITE_FEATURE_EXPEDITIONS=true

# First-install admin (ignored once an admin exists). `local` falls back to
# admin@lodenica.sk / Lodenica2026!; production REQUIRES these.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# SEED_DEMO_DATA=false
